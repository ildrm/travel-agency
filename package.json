{
  "name": "atlas-leisure-platform",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-2.0-only",
  "scripts": {
    "setup": "python3 deploy/local.py setup --activate-atlas",
    "start": "python3 deploy/local.py start",
    "stop": "python3 deploy/local.py stop",
    "test:static": "python3 tests/static.py",
    "test:integration": "python3 tests/run-integration.py",
    "test:browser": "playwright test --workers=1",
    "package": "python3 deploy/package.py"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1"
  }
}
